@model IEnumerable<Service_Desk.Models.Ticket>
@inject Service_Desk.Models.ServiceDeskContext Database

@{
    ViewData["Title"] = "Support – Tickets";
    var selectedStatus = Context.Request.Query["status"].ToString();
    var selectedPrioritaet = Context.Request.Query["prioritaet"].ToString();
    var selectedSortierung = Context.Request.Query["sortierung"].ToString();

    // SORTIERUNG: Standardmäßig stehen die neuesten Tickets oben.
    var sortierteTickets = selectedSortierung == "aufsteigend"
        ? Model.OrderBy(ticket => ticket.Erstellungsdatum)
        : Model.OrderByDescending(ticket => ticket.Erstellungsdatum);

    // SUPPORT: Die Statuszahlen beziehen sich immer auf alle Tickets, unabhängig vom aktiven Filter.
    var offeneTickets = Database.Tickets.Count(ticket => ticket.Status == TicketStatus.Offen);
    var ticketsInBearbeitung = Database.Tickets.Count(ticket => ticket.Status == TicketStatus.InBearbeitung);
    var abgeschlosseneTickets = Database.Tickets.Count(ticket => ticket.Status == TicketStatus.Abgeschlossen);

    // Status und Priorität der Tickets.
    var diagrammTickets = Database.Tickets
        .Select(ticket => new
        {
            ticket.Status,
            ticket.Prioritaet
        })
        .ToList();

    // Erster Balken: Prioritäten aller offenen Tickets.
    var offenNiedrig = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.Offen &&
        ticket.Prioritaet == Prioritaet.Niedrig);

    var offenMittel = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.Offen &&
        ticket.Prioritaet == Prioritaet.Mittel);

    var offenHoch = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.Offen &&
        ticket.Prioritaet == Prioritaet.Hoch);

        // Zweiter Balken: Prioritäten aller Tickets in Bearbeitung.
    var bearbeitungNiedrig = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.InBearbeitung &&
        ticket.Prioritaet == Prioritaet.Niedrig);

    var bearbeitungMittel = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.InBearbeitung &&
        ticket.Prioritaet == Prioritaet.Mittel);

    var bearbeitungHoch = diagrammTickets.Count(ticket =>
        ticket.Status == TicketStatus.InBearbeitung &&
        ticket.Prioritaet == Prioritaet.Hoch);

        // Dritter Balken: Prioritäten aller Tickets.
    var alleNiedrig = diagrammTickets.Count(ticket =>
        ticket.Prioritaet == Prioritaet.Niedrig);

    var alleMittel = diagrammTickets.Count(ticket =>
        ticket.Prioritaet == Prioritaet.Mittel);

    var alleHoch = diagrammTickets.Count(ticket =>
        ticket.Prioritaet == Prioritaet.Hoch);

        // Gesamtsummen der drei Balken.
    var offenGesamt = offenNiedrig + offenMittel + offenHoch;

    var bearbeitungGesamt =
        bearbeitungNiedrig + bearbeitungMittel + bearbeitungHoch;

    var alleGesamt = alleNiedrig + alleMittel + alleHoch;

    // Alle Tickets bilden mit 100 Prozent den gemeinsamen Vergleichswert.
    var vergleichsGesamt = Math.Max(1, alleGesamt);

    int BalkenBreite(int anzahl)
    {
        return (int)Math.Round(anzahl * 100.0 / vergleichsGesamt);
    }
}
<h1>Support – Tickets</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="mb-0">Alle Tickets verwalten, bearbeiten oder erneut öffnen.</p>
    <a asp-action="Create" class="btn btn-primary">Neues Ticket</a>
</div>

<!-- SUPPORT: Drei Prioritätsübersichten links, abgeschlossene Tickets rechts. -->
<section class="row g-3 mb-4 align-items-stretch" aria-label="Ticketübersicht">
    <div class="col-lg-9">
        <div class="d-flex justify-content-end gap-2 mb-2" aria-label="Prioritätslegende">
            <span class="badge text-bg-success">Niedrig</span>
            <span class="badge text-bg-warning">Mittel</span>
            <span class="badge text-bg-danger">Hoch</span>
        </div>

        <div class="d-flex flex-column gap-2" aria-label="Ticketstatus mit Prioritäten">
            <div class="status-card status-card-open status-card-with-priorities">
                <i class="bi bi-ticket-perforated status-card-icon" aria-hidden="true"></i>
                <div class="status-card-content">
                    <span class="status-card-number">@offeneTickets</span>
                    <span>Offen</span>
                </div>
                <div class="progress-stacked status-card-priorities" aria-label="Prioritäten offener Tickets">
                    <div class="progress" role="progressbar" aria-label="Niedrig" aria-valuenow="@offenNiedrig" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(offenNiedrig))%;">
                        <div class="progress-bar bg-success">@offenNiedrig</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Mittel" aria-valuenow="@offenMittel" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(offenMittel))%;">
                        <div class="progress-bar bg-warning text-dark">@offenMittel</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Hoch" aria-valuenow="@offenHoch" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(offenHoch))%;">
                        <div class="progress-bar bg-danger">@offenHoch</div>
                    </div>
                </div>
            </div>

            <div class="status-card status-card-progress status-card-with-priorities">
                <i class="bi bi-arrow-repeat status-card-icon" aria-hidden="true"></i>
                <div class="status-card-content">
                    <span class="status-card-number">@ticketsInBearbeitung</span>
                    <span>In Bearbeitung</span>
                </div>
                <div class="progress-stacked status-card-priorities" aria-label="Prioritäten der Tickets in Bearbeitung">
                    <div class="progress" role="progressbar" aria-label="Niedrig" aria-valuenow="@bearbeitungNiedrig" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(bearbeitungNiedrig))%;">
                        <div class="progress-bar bg-success">@bearbeitungNiedrig</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Mittel" aria-valuenow="@bearbeitungMittel" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(bearbeitungMittel))%;">
                        <div class="progress-bar bg-warning text-dark">@bearbeitungMittel</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Hoch" aria-valuenow="@bearbeitungHoch" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(bearbeitungHoch))%;">
                        <div class="progress-bar bg-danger">@bearbeitungHoch</div>
                    </div>
                </div>
            </div>

            <div class="status-card status-card-all status-card-with-priorities">
                <i class="bi bi-collection-fill status-card-icon" aria-hidden="true"></i>
                <div class="status-card-content">
                    <span class="status-card-number">@alleGesamt</span>
                    <span>Alle Tickets</span>
                </div>
                <div class="progress-stacked status-card-priorities" aria-label="Prioritäten aller Tickets">
                    <div class="progress" role="progressbar" aria-label="Niedrig" aria-valuenow="@alleNiedrig" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(alleNiedrig))%;">
                        <div class="progress-bar bg-success">@alleNiedrig</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Mittel" aria-valuenow="@alleMittel" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(alleMittel))%;">
                        <div class="progress-bar bg-warning text-dark">@alleMittel</div>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Hoch" aria-valuenow="@alleHoch" aria-valuemin="0" aria-valuemax="@vergleichsGesamt" style="width: @(BalkenBreite(alleHoch))%;">
                        <div class="progress-bar bg-danger">@alleHoch</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="status-card status-card-complete h-100 justify-content-center">
            <i class="bi bi-check-circle-fill status-card-icon" aria-hidden="true"></i>
            <div class="status-card-content">
                <span class="status-card-number">@abgeschlosseneTickets</span>
                <span>Abgeschlossen</span>
            </div>
        </div>
    </div>
</section>

<!-- FILTERLAYOUT: Vier gleich breite Auswahlfelder und ein breiter Aktionsbereich. -->
<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-6 col-xl-2">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">Alle Status</option>
            @foreach (var value in Enum.GetValues<TicketStatus>())
            {
                if (selectedStatus == value.ToString())
                {
                    <option value="@value" selected>@value</option>
                }
                else
                {
                    <option value="@value">@value</option>
                }
            }
        </select>
    </div>
    <div class="col-md-6 col-xl-2">
        <label for="prioritaet" class="form-label">Priorität</label>
        <select id="prioritaet" name="prioritaet" class="form-select">
            <option value="">Alle Prioritäten</option>
            @foreach (var value in Enum.GetValues<Prioritaet>())
            {
                if (selectedPrioritaet == value.ToString())
                {
                    <option value="@value" selected>@value</option>
                }
                else
                {
                    <option value="@value">@value</option>
                }
            }
        </select>
    </div>
    <div class="col-md-6 col-xl-2">
        <label for="kategorie" class="form-label">Kategorie</label>
        <select id="kategorie" name="kategorie" asp-items="ViewBag.KategorieId" class="form-select">
            <option value="">Alle Kategorien</option>
        </select>
    </div>
    <div class="col-md-6 col-xl-2">
        <label for="sortierung" class="form-label">Erstellungsdatum</label>
        <select id="sortierung" name="sortierung" class="form-select">
            @if (selectedSortierung == "aufsteigend")
            {
                <option value="absteigend">Absteigend – neueste zuerst</option>
                <option value="aufsteigend" selected>Aufsteigend – älteste zuerst</option>
            }
            else
            {
                <option value="absteigend" selected>Absteigend – neueste zuerst</option>
                <option value="aufsteigend">Aufsteigend – älteste zuerst</option>
            }
        </select>
    </div>
    <div class="col-12 col-xl-4">
        <span class="form-label d-block">Aktionen</span>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filtern</button>
            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Zurücksetzen</a>
        </div>
    </div>
</form>

@if (!sortierteTickets.Any())
{
    <div class="alert alert-info">Zu dieser Auswahl wurden keine Tickets gefunden.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nr.</th>
                    <th>Titel</th>
                    <th>Erstellt von</th>
                    <th>Kategorie</th>
                    <th>Priorität</th>
                    <th>Status</th>
                    <th>Bearbeiter</th>
                    <th>Erstellt am</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in sortierteTickets)
                {
                    <tr>
                        <td>@ticket.TicketId</td>
                        <td>@ticket.Titel</td>
                        <td>@ticket.ErstelltVon</td>
                        <td>@(ticket.Kategorie?.KategorieName ?? "Keine Kategorie")</td>
                        <td>@ticket.Prioritaet</td>
                        <td>@ticket.Status</td>
                        <td>@(ticket.Mitarbeiter?.Name ?? "Nicht zugewiesen")</td>
                        <td>@ticket.Erstellungsdatum.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                                <a asp-action="Delete" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-outline-danger">Löschen</a>
                                @if (ticket.Status == TicketStatus.Abgeschlossen)
                                {
                                    <form asp-action="Reopen" asp-route-id="@ticket.TicketId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Wieder öffnen</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
