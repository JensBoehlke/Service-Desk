@model IEnumerable<Service_Desk.Models.IT_Mitarbeiter>
@inject Service_Desk.Models.ServiceDeskContext Database

@{
    ViewData["Title"] = "Admin-Bereich";
    var kategorien = ViewBag.Kategorien as IEnumerable<Service_Desk.Models.Kategorie>
                     ?? Enumerable.Empty<Service_Desk.Models.Kategorie>();
    // TESTDATEN: Ticketanzahlen werden in einem Schritt geladen; die Controller bleiben unverändert.
    var ticketAnzahlen = Database.Tickets
        .Where(ticket => ticket.MitarbeiterId.HasValue)
        .GroupBy(ticket => ticket.MitarbeiterId!.Value)
        .ToDictionary(group => group.Key, group => group.Count());

    // AUSLASTUNG: Gezählt werden nur aktive Tickets (Offen und In Bearbeitung), pro IT-Mitarbeiter.
    var aktiveAnzahlen = Database.Tickets
        .Where(ticket => ticket.MitarbeiterId.HasValue && ticket.Status != TicketStatus.Abgeschlossen)
        .GroupBy(ticket => ticket.MitarbeiterId!.Value)
        .ToDictionary(group => group.Key, group => group.Count());
    var ohneBearbeiter = Database.Tickets
        .Count(ticket => ticket.MitarbeiterId == null && ticket.Status != TicketStatus.Abgeschlossen);
    var maxAktiv = Model.Any() ? Math.Max(1, Model.Max(m => aktiveAnzahlen.GetValueOrDefault(m.MitarbeiterId))) : 1;
}

<style>
    /* ADMIN-BEREICH: Team-Auslastung. Farben kommen aus site.css (--desk-*). */
    .auslastung-liste {
        margin: 0 0 1rem;
        padding: 0;
        list-style: none;
    }

    .auslastung-liste li {
        display: grid;
        grid-template-columns: minmax(6rem, 10rem) 1fr 2rem;
        align-items: center;
        gap: .75rem;
        margin-bottom: .6rem;
    }

    .auslastung-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .auslastung-spur {
        height: .55rem;
        overflow: hidden;
        border-radius: .3rem;
        background: #e3ece6;
    }

    .auslastung-spur span {
        display: block;
        height: 100%;
        border-radius: .3rem;
        background: var(--desk-green);
    }

    .auslastung-wert {
        text-align: right;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .auslastung-hinweis {
        padding: .75rem .9rem;
        border: 1px solid #f3dfa8;
        border-radius: .65rem;
        color: #5f4607;
        background: #fff7dd;
        font-size: .92rem;
    }

    @@media (max-width: 575.98px) {
        .auslastung-liste li { grid-template-columns: minmax(5rem, 7rem) 1fr 1.5rem; }
    }
</style>

<!-- TEAM: Die sechs Testpersonen werden in einer einfachen, gut lesbaren Liste gezeigt. -->
<div class="mb-4">
    TEST15
    <p class="section-label mb-1">Mitarbeitende</p>
    <!-- ADMIN: Der Bereich bündelt Mitarbeitende und Kategorien an einer Stelle. -->
    <h1 class="h2 mb-1">Admin-Bereich</h1>
    <p class="text-secondary mb-0">Drei Frauen und drei Männer stehen für die Bearbeitung der Test-Tickets bereit.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card content-card mb-4">
            <div class="card-header bg-white border-0 p-4 pb-2"><h2 class="h5 mb-0">Teamübersicht</h2></div>
            <div class="card-body pt-2">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Name</th><th>Tickets</th><th class="text-end">Aktionen</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Name</strong></td>
                                    <td><span class="badge-status">@(ticketAnzahlen.GetValueOrDefault(item.MitarbeiterId)) Ticket(s)</span></td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-mitarbeiterid="@item.MitarbeiterId" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
                                        <a asp-action="Delete" asp-route-mitarbeiterid="@item.MitarbeiterId" class="btn btn-sm btn-outline-danger">Löschen</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- AUSLASTUNG: Wie viele aktive Tickets hat jedes Teammitglied? (vorher auf der Startseite) -->
        <div class="card content-card">
            <div class="card-header bg-white border-0 p-4 pb-2">
                <h2 class="h5 mb-1">Team-Auslastung</h2>
                <p class="text-secondary small mb-0">Aktive Tickets pro Mitarbeiter, abgeschlossene zählen nicht mit.</p>
            </div>
            <div class="card-body pt-2">
                @if (!Model.Any())
                {
                    <p class="text-secondary mb-0">Noch keine Teammitglieder vorhanden.</p>
                }
                else
                {
                    <ul class="auslastung-liste">
                        @foreach (var item in Model.OrderByDescending(m => aktiveAnzahlen.GetValueOrDefault(m.MitarbeiterId)).ThenBy(m => m.Name))
                        {
                            var aktiv = aktiveAnzahlen.GetValueOrDefault(item.MitarbeiterId);
                            <li>
                                <span class="auslastung-name">@item.Name</span>
                                <span class="auslastung-spur"><span style="width:@(aktiv * 100 / maxAktiv)%"></span></span>
                                <span class="auslastung-wert">@aktiv</span>
                            </li>
                        }
                    </ul>
                }

                @if (ohneBearbeiter > 0)
                {
                    <p class="auslastung-hinweis mb-0">
                        <strong>@ohneBearbeiter</strong>
                        @(ohneBearbeiter == 1 ? "aktives Ticket hat" : "aktive Tickets haben")
                        noch keinen Bearbeiter. Zuweisen kannst du im
                        <a asp-controller="Support" asp-action="Index">Support</a>.
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- TEAM: Vorhandenes Create-Verhalten bleibt erhalten; nur die Darstellung wurde vereinfacht. -->
        <div class="card content-card mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Teammitglied hinzufügen</h2>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <label for="Name" class="form-label">Name</label>
                    <input type="text" id="Name" name="Name" class="form-control mb-3" maxlength="50" required />
                    <button type="submit" class="btn btn-primary w-100">Hinzufügen</button>
                </form>
            </div>
        </div>

        <div class="card content-card">
            <div class="card-header bg-white border-0 p-4 pb-2 d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Kategorien</h2>
                <a asp-controller="Kategorie" asp-action="Create" class="btn btn-sm btn-primary">Neue Kategorie</a>
            </div>
            <div class="card-body pt-2">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <tbody>
                            @foreach (var kategorie in kategorien)
                            {
                                <tr>
                                    <td><strong>@kategorie.KategorieName</strong></td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Kategorie" asp-action="Edit" asp-route-kategorieid="@kategorie.KategorieId" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
                                        <a asp-controller="Kategorie" asp-action="Delete" asp-route-kategorieid="@kategorie.KategorieId" class="btn btn-sm btn-outline-danger">Löschen</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
