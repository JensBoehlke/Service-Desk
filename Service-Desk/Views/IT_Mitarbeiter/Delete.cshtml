@model Service_Desk.Models.IT_Mitarbeiter

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

    <h3>Soll dieser IT-Mitarbeiter gelöscht werden?</h3>
    @if (ViewBag.DeleteError != null)
    {
        <div class="alert alert-danger">@ViewBag.DeleteError</div>
    }
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    @if (ViewBag.Tickets is IEnumerable<Service_Desk.Models.Ticket> tickets && tickets.Any())
    {
        <h4>Zugewiesene Tickets</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Titel</th>
                        <th>Status</th>
                        <th>Priorität</th>
                        <th>Erstellt am</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in tickets)
                    {
                        <tr>
                            <td>@ticket.TicketId</td>
                            <td>@ticket.Titel</td>
                            <td>@ticket.Status</td>
                            <td>@ticket.Prioritaet</td>
                            <td>@ticket.Erstellungsdatum.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (ViewBag.HatTickets == true)
    {
        <div class="alert alert-warning">Dieser Mitarbeiter kann nicht gelöscht werden, solange ihm Tickets zugewiesen sind.</div>
    }
    else
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="MitarbeiterId" />
            <input type="submit" value="Löschen" class="btn btn-danger" />
        </form>
    }
        <a class="btn btn-secondary mt-2" asp-action="Index">Back to List</a>
</div>
