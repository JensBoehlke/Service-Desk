@model Service_Desk.Models.Kategorie

@{
    ViewData["Title"] = "Delete";
}

<h1>Kategorie entfernen</h1>

<h3>Sind Sie sicher, dass Sie diese Kategorie löschen möchten?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.KategorieName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KategorieName)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tickets)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tickets)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="KategorieId" />
        <input type="submit" value="Löschen" class="btn btn-danger mt-2" />
        <a class="btn btn-secondary mt-2" asp-action ="Index">Zur Übersicht</a>
    </form>
</div>
