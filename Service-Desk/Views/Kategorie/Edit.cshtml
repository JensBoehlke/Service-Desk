@model Service_Desk.Models.Kategorie

@{
    ViewData["Title"] = "Edit";
}

<h1>Kategorie bearbeiten</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="KategorieId" />
            <div class="form-group">
                <label asp-for="KategorieName" class="control-label"></label>
                <input asp-for="KategorieName" class="form-control" />
                <span asp-validation-for="KategorieName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Speichern" class="btn btn-primary mt-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-secondary mt-2" asp-action="Index">Zur Übersicht</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
