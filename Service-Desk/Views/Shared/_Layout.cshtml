@{
    // NAVIGATION: Markiert den aktuell geöffneten Bereich in der linken Seitenleiste.
    var aktuellerController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavKlasse(string controller) => aktuellerController == controller
        ? "sidebar-link active"
        : "sidebar-link";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Service Desk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Service_Desk.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVIGATION: Die frühere Kopfleiste wurde durch eine feste linke Seitenleiste ersetzt. -->
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Hauptnavigation">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" aria-label="Service Desk Startseite">
                <span class="brand-mark">SD</span>
                <span class="sidebar-text">Service Desk</span>
            </a>

            <nav class="sidebar-nav">
                <a class="@NavKlasse("Home")" asp-controller="Home" asp-action="Index" title="Mitarbeiter">
                    <span class="nav-icon">M</span><span class="sidebar-text">Mitarbeiter</span>
                </a>
                <!-- NAVIGATION: Die Ticketübersicht liegt vollständig im Dashboard. -->
                <a class="@NavKlasse("Support")" asp-controller="Support" asp-action="Index" title="Support">
                    <span class="nav-icon">S</span><span class="sidebar-text">Support</span>
                </a>
                <!-- NAVIGATION: Kategorien sind kein eigener Menüpunkt mehr und bleiben im Admin-Bereich erreichbar. -->
                <a class="@NavKlasse("IT_Mitarbeiter")" asp-controller="IT_Mitarbeiter" asp-action="Index" title="Admin-Bereich">
                    <span class="nav-icon">A</span><span class="sidebar-text">Admin-Bereich</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="nav-icon">✓</span>
                <span class="sidebar-text">Service bereit</span>
            </div>
        </aside>

        <!-- LAYOUT: Der Seiteninhalt nutzt weiterhin den vorhandenen Bootstrap-Container. -->
        <div class="app-page">
            <main class="main-content" role="main">
                <div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer py-3">
                <div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
                    <span>&copy; 2026 Service Desk</span>
                    <span>Einfach. Übersichtlich. Grün.</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
