@{
    // NAVIGATION: Markiert den aktuell geöffneten Bereich in der linken Seitenleiste.
    var aktuellerController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavKlasse(string controller) => aktuellerController == controller
        ? "sidebar-link active"
        : "sidebar-link";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Service Desk</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.13.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Service_Desk.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVIGATION: Die frühere Kopfleiste wurde durch eine feste linke Seitenleiste ersetzt. -->
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Hauptnavigation">
            <a class="sidebar-brand sidebar-brand--company d-flex flex-column align-items-stretch""
               asp-controller="Home" asp-action="Index"
               aria-label="Westfalen Office Solutions GmbH – Service Desk Startseite">
               <span class="company-brand-row d-flex align-items-center gap-2">
                    <img class="company-logo"
                    src="~/images/westfalen-logo.png"
                    alt=""
                    style="width: 60px; height: 60px; flex-shrink: 0; object-fit: contain;" />
                    <span class="company-name d-flex flex-column lh-sm">
                        <span>Westfalen Office</span>
                        <span>Solutions GmbH</span>
                    </span>
                </span>
                <span class="d-block w-100 my-2" aria-hidden="true"
      style="height: 2px; background-color: #a8edc5;"></span>

<span class="d-flex align-items-center justify-content-center gap-2 w-100">
    <i class="bi bi-ticket-perforated fs-4" aria-hidden="true"></i>
    <span>Service Desk</span>
</span>
                @* <span class="company-subtitle">Service Desk</span> *@
            </a>

            <nav class="sidebar-nav">
                <a class="@NavKlasse("Home")" asp-controller="Home" asp-action="Index" title="Mitarbeiter">
                    <span class="nav-icon" aria-hidden="true">
                        <i class="bi bi-people-fill fs-4" style="color: #07482f; font-size: 16px;"></i>
                    </span><span class="sidebar-text">Mitarbeiter</span>
                </a>
                <!-- NAVIGATION: Die Ticketübersicht liegt vollständig im Dashboard. -->
                <a class="@NavKlasse("Support")" asp-controller="Support" asp-action="Index" title="Support">
                    <span class="nav-icon" aria-hidden="true">
                        <i class="bi-pc-display fs-4" style="color: #07482f; font-size: 16px;"></i>
                    </span>
                    <span class="sidebar-text">Support</span>
                </a>
                <!-- NAVIGATION: Kategorien sind kein eigener Menüpunkt mehr und bleiben im Admin-Bereich erreichbar. -->
                <a class="@NavKlasse("IT_Mitarbeiter")" asp-controller="IT_Mitarbeiter" asp-action="Index" title="Admin-Bereich">
                    <span class="nav-icon" aria-hidden="true">
                        <i class="bi-shield-lock fs-4" style="color: #07482f; font-size: 16px;"></i>
                    </span>
                    <span class="sidebar-text">Admin-Bereich</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="nav-icon">✓</span>
                <span class="sidebar-text">Service bereit</span>
            </div>
        </aside>

        <!-- LAYOUT: Der Seiteninhalt nutzt weiterhin den vorhandenen Bootstrap-Container. -->
        <div class="app-page">
            <main class="main-content" role="main">
                <div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer py-3">
                <div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
                    <span>&copy; 2026 Service Desk</span>
                    <span>Einfach. Übersichtlich. Grün.</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
