@model Service_Desk.Models.Ticket

@{
    ViewData["Title"] = "Ticket erstellen";
}
<h1>Ticket erstellen</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        @* Das Formular sendet die Eingaben an die POST-Methode im TicketController. *@
        <form asp-controller="Ticket" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ErstelltVon" class="control-label"></label>
                <input asp-for="ErstelltVon" class="form-control" />
                <span asp-validation-for="ErstelltVon" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="KategorieId" class="control-label"></label>

                <select asp-for="KategorieId"
                        asp-items="ViewBag.KategorieId"
                        class="form-select">
                    <option value="">Bitte Kategorie auswählen</option>
                </select>

                <span asp-validation-for="KategorieId"
                      class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="Titel" class="control-label"></label>
                <input asp-for="Titel" class="form-control" />
                <span asp-validation-for="Titel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                @* asp-for erzeugt auch name="Beschreibung", damit der Text beim Speichern ankommt. *@
                <label asp-for="Beschreibung" class="form-label">Nachricht</label>
                <textarea asp-for="Beschreibung" class="form-control" rows="4"></textarea>
                @* Zeigt z. B. die Fehlermeldung bei einer leeren Beschreibung an. *@
                <span asp-validation-for="Beschreibung" class="text-danger"></span>
            </div>

            
            <div class="form-group">
                <input type="submit" value="Speichern" class="btn btn-primary mt-2 mb-2" />
            </div>
        </form>
    </div>
</div>

<div>
    @* Zurück zur Ticketliste, zu der auch nach dem Speichern weitergeleitet wird. *@
    <a asp-controller="Ticket" asp-action="Index" class="btn btn-outline-secondary">Zurück zur Ticketübersicht</a>
</div>

@section Scripts {
    @* Prüft Pflichtfelder schon im Browser, genauso wie im Support-Formular. *@
    <partial name="_ValidationScriptsPartial" />
}
