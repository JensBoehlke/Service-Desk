@model Service_Desk.Models.Ticket

@{
    ViewData["Title"] = "Create";
}
<h1>Ticket erstellen</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ErstelltVon" class="control-label"></label>
                <input asp-for="ErstelltVon" class="form-control" />
                <span asp-validation-for="ErstelltVon" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Titel" class="control-label"></label>
                <input asp-for="Titel" class="form-control" />
                <span asp-validation-for="Titel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Beschreibung" class="control-label"></label>
                <input asp-for="Beschreibung" class="form-control textarea" />
                <span asp-validation-for="Beschreibung" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="KategorieId" class="control-label"></label>

                <select asp-for="KategorieId"
                    asp-items="ViewBag.KategorieId"
                    class="form-select">
                <option value="">Bitte Kategorie auswählen</option>
                </select>
               
                <span asp-validation-for="KategorieId"
                    class="text-danger"></span>
                
            </div>
            
            <div class="form-group">
                <input type="submit" value="speichern" class="btn btn-primary" css-border="2px solid red" />
            </div>
        </form>
    </div>
</div>

<br />

<div>
    <!-- NAVIGATION: Vom Ticketformular geht es zurück zur zentralen Übersicht im Dashboard. -->
    <a asp-controller="Home" asp-action="Index">Zurück zur Startseite</a>
</div>
