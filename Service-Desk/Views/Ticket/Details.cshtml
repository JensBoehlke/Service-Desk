@model Service_Desk.Models.Ticket

@{
    ViewData["Title"] = "Ticketdetails";
}

<h1>Ticket #@Model.TicketId</h1>

<div class="card mb-3">
    <div class="card-header">
        <strong>@Model.Titel</strong>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Erstellt von</dt>
            <dd class="col-sm-9">@Model.ErstelltVon</dd>

            <dt class="col-sm-3">Beschreibung</dt>
            <dd class="col-sm-9" style="white-space: pre-wrap">@Model.Beschreibung</dd>

            <dt class="col-sm-3">Kategorie</dt>
            <dd class="col-sm-9">@(Model.Kategorie?.KategorieName ?? "Keine Kategorie")</dd>
@* 
            <dt class="col-sm-3">Priorität</dt>
            <dd class="col-sm-9">@Model.Prioritaet</dd> *@

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
@* 
            <dt class="col-sm-3">Bearbeiter</dt>
            <dd class="col-sm-9">@(Model.Mitarbeiter?.Name ?? "Nicht zugewiesen")</dd>
 *@
            <dt class="col-sm-3">Erstellt am</dt>
            <dd class="col-sm-9">@Model.Erstellungsdatum.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    @* Tickets werden nur im Support-Bereich bearbeitet. *@

    <a asp-action="Index" class="btn btn-outline-secondary">Zur Übersicht</a>
</div>


